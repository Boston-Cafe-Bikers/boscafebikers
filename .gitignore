# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Env / secrets — the real ICS URL lives only in the PARTIFUL_ICS_URL secret
.env
*.env

# Ralph loop scratch (lives in ralph/ — do not commit)
ralph.log

# Working copies of a page kept while comparing two versions of it. They must
# never live in site/: pages.yml publishes that directory wholesale, so a
# scratch copy there is a public URL (and tests/test_site_html.py fails it,
# which is how site/__old.html was caught — it predates the CSP <meta> every
# published page has to carry). Keep them here instead.
scratch/
site/__*.html

# OS
.DS_Store

# Generated ride data — the only copy lives on the `data` branch; the sync bot
# writes it there and pages.yml copies it into the published trees. Pull it
# into a local checkout with scripts/pull_data.sh (the files below are what it
# extracts).
site/events.json
site/events-past.json
site/cafe-points.json
site/rides.ics
site/maps/
site/posters/
# …plus the run report sync.py writes beside them (data branch only).
site/sync-report.json
